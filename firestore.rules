rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(uid) { return request.auth != null && request.auth.uid == uid; }
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    match /users/{uid}/savedMessages/{savedId} {
      allow read, delete: if verified() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['conversationId', 'messageId', 'savedAt'])
        && request.resource.data.conversationId is string
        && request.resource.data.messageId is string
        && savedId == request.resource.data.conversationId + '_' + request.resource.data.messageId
        && request.resource.data.savedAt == request.time
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)/messages/$(request.resource.data.messageId));
    }
    match /conversations/{conversationId} {
      allow get: if verified() && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
        || request.auth.uid in resource.data.participants);
      allow list: if verified() && request.auth.uid in resource.data.participants;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['participants', 'createdAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && conversationId == string(request.resource.data.participants[0].size()) + ':' + request.resource.data.participants[0]
          + string(request.resource.data.participants[1].size()) + ':' + request.resource.data.participants[1]
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0])/contacts/$(request.resource.data.participants[1]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1])/contacts/$(request.resource.data.participants[0]));
      // A preview must reference a new message committed in this same atomic write.
      allow update: if verified() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastMessageId'])
        && request.resource.data.lastMessageId is string
        && !exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId))
        && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)).data.text == request.resource.data.lastMessage
        && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageAt == request.time;
      match /messages/{messageId} {
        function participant() {
          return verified() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if participant();
        allow create: if participant()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.text.size() > 0
          && request.resource.data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessage == request.resource.data.text
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessageAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastSenderId == request.auth.uid;
        // Message edits and deletes are intentionally denied.
      }
    }
    match /publicProfiles/{uid} {
      allow get: if verified();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'customNumber', 'avatar'])
        && request.resource.data.fullName == getAfter(/databases/$(database)/documents/users/$(uid)).data.fullName
        && request.resource.data.customNumber == getAfter(/databases/$(database)/documents/users/$(uid)).data.customNumber
        && request.resource.data.avatar == getAfter(/databases/$(database)/documents/users/$(uid)).data.get('avatar', {'character': 0, 'hoodieColor': 'rose', 'skinTone': 0, 'glasses': true, 'badge': 'sparkle'});
    }
    match /friendRequestLocks/{lockId} {
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'requestId'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && (lockId == request.auth.uid + '_' + request.resource.data.toUid || lockId == request.resource.data.toUid + '_' + request.auth.uid)
        && request.resource.data.requestId == request.auth.uid + '_' + request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.resource.data.toUid;
    }
    match /users/{ownerUid}/contacts/{contactUid} {
      allow read: if verified() && request.auth.uid == ownerUid;
      // Existing contacts may only receive an identical, validated write (retry/repair).
      allow create, update: if verified()
        && (!exists(/databases/$(database)/documents/users/$(ownerUid)/contacts/$(contactUid))
          || request.resource.data == resource.data)
        && request.resource.data.keys().hasOnly(['uid', 'requestId'])
        && request.resource.data.uid == contactUid
        && ownerUid != contactUid
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && (request.auth.uid == ownerUid || request.auth.uid == contactUid)
        && ((getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid == ownerUid
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == contactUid)
          || (getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == ownerUid
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid == contactUid));
    }
    match /friendRequests/{requestId} {
      allow update: if verified()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (request.resource.data.status == 'declined'
          || (request.resource.data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/users/$(resource.data.fromUid)/contacts/$(resource.data.toUid)).data.requestId == requestId
            && getAfter(/databases/$(database)/documents/users/$(resource.data.toUid)/contacts/$(resource.data.fromUid)).data.requestId == requestId));
      allow get: if verified() && (!exists(/databases/$(database)/documents/friendRequests/$(requestId))
        || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if verified() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/friendRequestLocks/$(requestId)).data.requestId == requestId
        && getAfter(/databases/$(database)/documents/friendRequestLocks/$(request.resource.data.toUid + '_' + request.auth.uid)).data.requestId == requestId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && !exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.auth.uid));
    }
    match /numbers/{number} {
      // Signup checks one exact number before authentication; collection listing is denied.
      allow get: if number.matches('^[0-9]{6,15}$');
      allow create: if request.auth != null
        && number.matches('^[0-9]{6,15}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.customNumber == number;
    }
    match /users/{uid} {
      // Private account reads depend only on authenticated ownership, not verification or public-profile writes.
      allow get: if ownsProfile(uid);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar'])
        && request.resource.data.avatar is map
        && request.resource.data.avatar.keys().hasOnly(['character', 'hoodieColor', 'skinTone', 'glasses', 'badge'])
        && request.resource.data.avatar.character in [0, 1, 2]
        && request.resource.data.avatar.hoodieColor in ['rose', 'lavender', 'amber']
        && request.resource.data.avatar.skinTone in [0, 1, 2]
        && request.resource.data.avatar.glasses is bool
        && request.resource.data.avatar.badge in ['sparkle', 'heart', 'moon', 'none']
;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'email', 'customNumber', 'createdAt', 'avatar'])
        && request.resource.data.avatar is map
        && request.resource.data.avatar.keys().hasOnly(['character', 'hoodieColor', 'skinTone', 'glasses', 'badge'])
        && request.resource.data.avatar.character in [0, 1, 2]
        && request.resource.data.avatar.hoodieColor in ['rose', 'lavender', 'amber']
        && request.resource.data.avatar.skinTone in [0, 1, 2]
        && request.resource.data.avatar.glasses is bool
        && request.resource.data.avatar.badge in ['sparkle', 'heart', 'moon', 'none']
        && request.resource.data.fullName is string
        && request.resource.data.fullName.matches('.*[^ ].*')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.customNumber is string
        && request.resource.data.customNumber.matches('^[0-9]{6,15}$')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/numbers/$(request.resource.data.customNumber)).data.uid == uid;
    }
  }
}
